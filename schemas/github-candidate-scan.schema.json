{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesomecua.github.io/schemas/github-candidate-scan.schema.json",
  "title": "Public GitHub candidate metadata observations",
  "description": "Independent candidate ledger. Numeric repository IDs count once; metadata observation is neither relevance review nor active-catalog approval. Pagination statuses describe observed API windows, not global recall. Version2 retains explicit migration/topic-expansion/daily/frontier epoch history and bounded full-traversal restarts; v1 is still readable. Shared reservations may exceed HTTP attempts when I/O is deferred after reservation. New UTC frontiers retain unfinished historical queries; scoped runs derive repair epoch permissions from prior progress.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "policy",
    "configuration",
    "inputs",
    "records",
    "queries",
    "receipts",
    "runs",
    "deferred_until"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ],
      "type": "integer"
    },
    "provider": {
      "const": "github"
    },
    "policy": {
      "type": "string"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topics",
        "created_after",
        "created_before"
      ],
      "properties": {
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "computer-use",
              "gui-agent",
              "gui-agents",
              "gui-automation",
              "desktop-automation",
              "browser-agent",
              "browser-agents",
              "browser-automation",
              "android-automation",
              "computer-use-agent",
              "computer-use-agents",
              "gui-grounding",
              "browser-use",
              "web-agent",
              "web-agents",
              "desktop-agent",
              "mobile-agent"
            ]
          }
        },
        "created_after": {
          "type": "string",
          "format": "date"
        },
        "created_before": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "files",
          "active_records",
          "curated_records",
          "existing_seed_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "files": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "catalog.jsonl",
              "candidates.jsonl",
              "primary-evidence.jsonl",
              "repository-aliases.json",
              "candidate-reviews.json"
            ],
            "properties": {
              "catalog.jsonl": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "candidates.jsonl": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "primary-evidence.jsonl": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "repository-aliases.json": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "candidate-reviews.json": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "active_records": {
            "type": "integer",
            "minimum": 0
          },
          "curated_records": {
            "type": "integer",
            "minimum": 0
          },
          "existing_seed_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "records": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^github-repository:[1-9][0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/record"
      }
    },
    "queries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/searchQuery"
          },
          {
            "$ref": "#/$defs/existingQuery"
          }
        ]
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/receipt"
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "deferred_until": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "epochs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/epoch"
      }
    },
    "current_epoch_id": {
      "type": "string",
      "pattern": "^epoch:[0-9a-f]{24}$"
    },
    "query_rechecks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/queryRecheck"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository_id",
        "canonical_id",
        "full_name",
        "url",
        "description",
        "topics",
        "private",
        "visibility",
        "fork",
        "archived",
        "created_at",
        "updated_at",
        "pushed_at",
        "metadata_status",
        "review_status",
        "scope",
        "first_observed_at",
        "last_observed_at",
        "known_names",
        "occurrences"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^github-repository:[1-9][0-9]*$"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "canonical_id": {
          "type": "string",
          "pattern": "^github:[a-z0-9][a-z0-9-]*/[a-z0-9_.-]+$"
        },
        "full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://github[.]com/[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+$"
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "topics": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 100,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"
          }
        },
        "private": {
          "const": false
        },
        "visibility": {
          "const": "public"
        },
        "fork": {
          "const": false
        },
        "archived": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "pushed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata_status": {
          "const": "primary_metadata_observed"
        },
        "review_status": {
          "const": "candidate"
        },
        "scope": {
          "const": "relevance_pending"
        },
        "first_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "known_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+$"
          }
        },
        "occurrences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "query_id",
              "receipt_id",
              "position"
            ],
            "properties": {
              "query_id": {
                "type": "string",
                "pattern": "^(search:[0-9a-f]{24}|existing:[0-9a-f]{64})$"
              },
              "receipt_id": {
                "type": "string",
                "pattern": "^receipt:[0-9a-f]{64}$"
              },
              "position": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "searchQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "topic",
        "created_after",
        "created_before",
        "query",
        "parent_id",
        "next_page",
        "status",
        "last_attempt",
        "reported_total",
        "total_changed",
        "incomplete_results_seen",
        "seen_repository_ids",
        "rejected_rows"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^search:[0-9a-f]{24}$"
        },
        "kind": {
          "const": "search"
        },
        "topic": {
          "enum": [
            "computer-use",
            "gui-agent",
            "gui-agents",
            "gui-automation",
            "desktop-automation",
            "browser-agent",
            "browser-agents",
            "browser-automation",
            "android-automation",
            "computer-use-agent",
            "computer-use-agents",
            "gui-grounding",
            "browser-use",
            "web-agent",
            "web-agents",
            "desktop-agent",
            "mobile-agent"
          ]
        },
        "created_after": {
          "type": "string",
          "format": "date"
        },
        "created_before": {
          "type": "string",
          "format": "date"
        },
        "query": {
          "type": "string",
          "pattern": "^topic:[a-z-]+ is:public fork:false created:[0-9]{4}-[0-9]{2}-[0-9]{2}[.][.][0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(search:[0-9a-f]{24}|existing:[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 11
        },
        "status": {
          "enum": [
            "pending",
            "split",
            "blocked_single_day_window",
            "observed_pages_exhausted",
            "partial_results",
            "partial_api_window"
          ]
        },
        "last_attempt": {
          "type": "integer",
          "minimum": 0
        },
        "reported_total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "total_changed": {
          "type": "boolean"
        },
        "incomplete_results_seen": {
          "type": "boolean"
        },
        "seen_repository_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "rejected_rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "existingQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "input_id",
        "seed_count",
        "next_index",
        "status",
        "last_attempt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^existing:[0-9a-f]{64}$"
        },
        "kind": {
          "const": "existing"
        },
        "input_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed_count": {
          "type": "integer",
          "minimum": 0
        },
        "next_index": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "pending",
            "exhausted",
            "superseded_input"
          ]
        },
        "last_attempt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "run_id",
        "query_id",
        "position",
        "requested_at",
        "finished_at",
        "status",
        "request_url_sha256",
        "response_sha256",
        "response_bytes",
        "outcome",
        "source_url",
        "accepted_repository_ids",
        "rejected_rows",
        "raw_body_retained",
        "reported_total",
        "incomplete_results",
        "returned_count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^receipt:[0-9a-f]{64}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run:[0-9a-f]{24}$"
        },
        "query_id": {
          "type": "string",
          "pattern": "^(search:[0-9a-f]{24}|existing:[0-9a-f]{64})$"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            {
              "type": "null"
            }
          ]
        },
        "request_url_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "enum": [
            "accepted",
            "accepted_with_rejections",
            "rejected",
            "rate_limited",
            "unavailable",
            "redirect_not_followed",
            "fetch_failed",
            "response_too_large",
            "malformed_response",
            "quarantined"
          ]
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://api[.]github[.]com/(repos/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+|search/repositories[?].+)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "accepted_repository_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "rejected_rows": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "private_or_unknown": {
              "type": "integer",
              "minimum": 0
            },
            "visibility_not_public_or_unknown": {
              "type": "integer",
              "minimum": 0
            },
            "fork_or_unknown": {
              "type": "integer",
              "minimum": 0
            },
            "malformed": {
              "type": "integer",
              "minimum": 0
            },
            "outside_created_bounds": {
              "type": "integer",
              "minimum": 0
            },
            "query_topic_mismatch": {
              "type": "integer",
              "minimum": 0
            },
            "requested_repository_mismatch": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "raw_body_retained": {
          "type": "boolean"
        },
        "reported_total": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "incomplete_results": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "returned_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input_id",
        "started_at",
        "finished_at",
        "status",
        "request_budget",
        "wall_seconds_budget",
        "requests_attempted",
        "new_unique_repositories",
        "accepted_metadata_rows",
        "rejected_rows",
        "unknown_requests",
        "deferred_queries",
        "deferred_query_ids",
        "before_unique_repositories",
        "after_unique_repositories"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^run:[0-9a-f]{24}$"
        },
        "input_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "running",
            "rate_limited",
            "wall_budget",
            "request_budget",
            "partial",
            "finished"
          ]
        },
        "request_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "wall_seconds_budget": {
          "type": "number",
          "minimum": 1,
          "maximum": 900
        },
        "requests_attempted": {
          "type": "integer",
          "minimum": 0
        },
        "new_unique_repositories": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_metadata_rows": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_rows": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "private_or_unknown": {
              "type": "integer",
              "minimum": 0
            },
            "visibility_not_public_or_unknown": {
              "type": "integer",
              "minimum": 0
            },
            "fork_or_unknown": {
              "type": "integer",
              "minimum": 0
            },
            "malformed": {
              "type": "integer",
              "minimum": 0
            },
            "outside_created_bounds": {
              "type": "integer",
              "minimum": 0
            },
            "query_topic_mismatch": {
              "type": "integer",
              "minimum": 0
            },
            "requested_repository_mismatch": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "unknown_requests": {
          "type": "integer",
          "minimum": 0
        },
        "deferred_queries": {
          "type": "integer",
          "minimum": 0
        },
        "deferred_query_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(search:[0-9a-f]{24}|existing:[0-9a-f]{64})$"
          }
        },
        "before_unique_repositories": {
          "type": "integer",
          "minimum": 0
        },
        "after_unique_repositories": {
          "type": "integer",
          "minimum": 0
        },
        "strict_replay": {
          "type": "boolean"
        },
        "epoch_id": {
          "type": "string",
          "pattern": "^epoch:[0-9a-f]{24}$"
        },
        "shared_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "round_id",
            "reservations_before",
            "reservations_after",
            "reservations_charged",
            "deferred_reason",
            "deferred_provider"
          ],
          "properties": {
            "round_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "reservations_before": {
              "type": "integer",
              "minimum": 0
            },
            "reservations_after": {
              "type": "integer",
              "minimum": 0
            },
            "reservations_charged": {
              "type": "integer",
              "minimum": 0
            },
            "deferred_reason": {
              "enum": [
                null,
                "request_budget",
                "wall_budget",
                "provider_cooldown"
              ]
            },
            "deferred_provider": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9.-]+$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "repair_epoch_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^epoch:[0-9a-f]{24}$"
          }
        }
      }
    },
    "epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "configuration",
        "root_query_ids",
        "created_at",
        "reason",
        "previous_epoch_id",
        "source_state_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^epoch:[0-9a-f]{24}$"
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topics",
            "created_after",
            "created_before"
          ],
          "properties": {
            "topics": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "computer-use",
                  "gui-agent",
                  "gui-agents",
                  "gui-automation",
                  "desktop-automation",
                  "browser-agent",
                  "browser-agents",
                  "browser-automation",
                  "android-automation",
                  "computer-use-agent",
                  "computer-use-agents",
                  "gui-grounding",
                  "browser-use",
                  "web-agent",
                  "web-agents",
                  "desktop-agent",
                  "mobile-agent"
                ]
              }
            },
            "created_after": {
              "type": "string",
              "format": "date"
            },
            "created_before": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "root_query_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^search:[0-9a-f]{24}$"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "enum": [
            "initial",
            "v1_migration",
            "topic_expansion",
            "daily_continuation",
            "frontier_continuation"
          ]
        },
        "previous_epoch_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^epoch:[0-9a-f]{24}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_state_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "queryRecheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "query_id",
        "epoch_id",
        "restarted_at",
        "receipt_boundary",
        "previous"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^recheck:[0-9a-f]{24}$"
        },
        "query_id": {
          "type": "string",
          "pattern": "^search:[0-9a-f]{24}$"
        },
        "epoch_id": {
          "type": "string",
          "pattern": "^epoch:[0-9a-f]{24}$"
        },
        "restarted_at": {
          "type": "string",
          "format": "date-time"
        },
        "receipt_boundary": {
          "type": "integer",
          "minimum": 0
        },
        "previous": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "next_page",
            "reported_total",
            "total_changed",
            "incomplete_results_seen",
            "seen_repository_ids",
            "rejected_rows",
            "last_attempt"
          ],
          "properties": {
            "status": {
              "enum": [
                "partial_results",
                "partial_api_window"
              ]
            },
            "next_page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 11
            },
            "reported_total": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "total_changed": {
              "type": "boolean"
            },
            "incomplete_results_seen": {
              "type": "boolean"
            },
            "seen_repository_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "rejected_rows": {
              "type": "integer",
              "minimum": 0
            },
            "last_attempt": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "run_id": {
          "type": "string",
          "pattern": "^run:[0-9a-f]{24}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "epochs",
          "current_epoch_id",
          "query_rechecks"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "epochs"
              ]
            },
            {
              "required": [
                "current_epoch_id"
              ]
            },
            {
              "required": [
                "query_rechecks"
              ]
            }
          ]
        }
      }
    }
  ]
}
